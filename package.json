{
  "name": "@logiskbrist/logisk-platform-auth",
  "version": "0.0.0-dev",
  "description": "Preview-aware Entra auth broker for the Logiskbrist platform. One redirect URI per app; per-PR testversjoner bounce through the prod host and get a signed handoff.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap --target node20 --external @azure/msal-node --external express",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@azure/msal-node": "^2 || ^3 || ^4 || ^5",
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@azure/msal-node": "^5.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.0.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logiskbrist/logisk-platform-auth.git"
  },
  "bugs": {
    "url": "https://github.com/logiskbrist/logisk-platform-auth/issues"
  },
  "homepage": "https://github.com/logiskbrist/logisk-platform-auth#readme",
  "publishConfig": {
    "access": "public"
  }
}
